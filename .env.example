# ==============================================================================
# MEDCARE HOSPITAL MANAGEMENT SYSTEM (HMS)
# Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Configure your database credentials and session secret below.
# 3. Never commit '.env' with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime environment: 'development' or 'production'
NODE_ENV=development

# Application HTTP server listening port
PORT=3000

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# API base URL for client requests (defaults to same-origin /api/v1)
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# 3. SESSION & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Secret key used to sign session cookies (REQUIRED in production).
# SECURITY REQUIREMENT: Use at least 32 random characters in production.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# API rate limiting: Maximum requests per 15-minute window per IP (default: 300)
RATE_LIMIT_MAX=300

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
# Choose EITHER Option A (DATABASE_URL) OR Option B (Discrete variables):

# --- OPTION A: Full Connection URI (Recommended for cloud / hosted PostgreSQL) ---
# Example: postgresql://postgres:your_password@127.0.0.1:5432/hospital_management
# DATABASE_URL=

# --- OPTION B: Discrete Connection Variables (Recommended for local / VPS setup) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hospital_management
DB_USER=postgres
DB_PASSWORD=

# Enable SSL/TLS for PostgreSQL connection ('true', 'false', 'require', 'verify-full')
DB_SSL=false

# Maximum database connection pool size (default: 10)
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD SQL (Optional - for Google Cloud deployments)
# ------------------------------------------------------------------------------
# Unix domain socket path (e.g. /cloudsql/project:region:instance)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 6. AUTOMATED TEST ISOLATION DATABASE
# ------------------------------------------------------------------------------
# Dedicated test database used by 'npm test' to prevent mutations on development data
TEST_DB_NAME=hospital_management_test

# ------------------------------------------------------------------------------
# 7. INITIAL ADMINISTRATOR PROVISIONING (Optional)
# ------------------------------------------------------------------------------
# If specified, the database initialization script creates this custom admin account.
# If left empty, default demo credentials (admin / Demo@1234) are seeded.
ADMIN_FULL_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
